# ── Database ────────────────────────────────────────────────────────────
# Dev (default): SQLite. Prod: MySQL, e.g.
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/fbr_integration
DATABASE_URL=sqlite:///./fbr_dev.db

# ── Auth ────────────────────────────────────────────────────────────────
# Change this in production — signs the JWT tokens for both dashboards.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# Bootstrap admin account (created on first startup if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# ── CORS (React dev server) ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
