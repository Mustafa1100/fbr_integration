# ── Environment ─────────────────────────────────────────────────────────
# "development" (default) or "production". Production hides the
# interactive API docs (/docs, /redoc, /openapi.json).
ENVIRONMENT=development

# ── Database ────────────────────────────────────────────────────────────
# Dev (default): SQLite. Prod: Postgres, e.g.
#   DATABASE_URL=postgresql+psycopg://user:password@host/pos
DATABASE_URL=sqlite:///./pos_dev.db

# ── Auth ────────────────────────────────────────────────────────────────
# Change this in production — signs the admin portal and desktop app tokens.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN_HOURS=12
# Desktop logins stay valid this long so the POS keeps working offline.
DEVICE_TOKEN_DAYS=400

# Bootstrap admin account (created on first startup if no admin exists).
# Use a strong password in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# Desktop logins are <name>@<this domain>
USERNAME_DOMAIN=pos.compliance.pk

# ── CORS (admin portal origin) ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
