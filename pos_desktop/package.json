{
  "name": "compliance-pakistan-pos",
  "productName": "Compliance Pakistan POS",
  "version": "1.0.0",
  "description": "Windows point of sale that fiscalizes invoices through the FBR Software Fiscal Component",
  "author": "Compliance Pakistan",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test",
    "dist": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "pk.compliancepakistan.pos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Compliance Pakistan POS",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CompliancePakistanPOS-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.56.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  }
}
